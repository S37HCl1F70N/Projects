[Unit]
Description=Network Black Box retention maintenance
After=network-black-box-collector.service

[Service]
Type=oneshot
User=network-black-box
Group=network-black-box
UMask=0007
Environment=PYTHONPATH=/opt/network-black-box/src
ExecStart=/usr/bin/python3 -m nbb.maintenance --config /etc/network-black-box/config.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/network-black-box /var/log/network-black-box
